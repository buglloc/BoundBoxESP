menu "SSH Server"

  config SSH_SERVER_PORT
    int "Server port to listen to"
    range 0 32000
    default 22

  config SSH_SERVER_BACKLOG
    int "Socket backlog size"
    range 1 46
    default 5

  config SSH_STREAM_WRITE_BUFFER_SIZE
    int "Stream write buffer size"
    default 4096

  config SSH_STREAM_READ_BUFFER_SIZE
    int "Stream read buffer size"
    default 256

  config SSH_STREAM_POLL_TIMEOUT
    int "Stream poll timeout (ms)"
    default 100

  config SSH_STREAM_READ_TIMEOUT
    int "Stream read timeout (ms)"
    default 5000

  config SSH_AUTH_RETRIES
    int "Auth retries"
    default 10

endmenu
